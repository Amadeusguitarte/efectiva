# syntax=docker/dockerfile:1

# Worker del CRM (WhatsApp por QR y correo). En Railway es un segundo servicio del mismo
# repositorio: en su configuración usa este archivo (RAILWAY_DOCKERFILE_PATH=Dockerfile.worker
# o el archivo railway.worker.json). No expone puertos.

FROM node:24-alpine AS base
ENV NODE_ENV=production

# ---- 1. Dependencias de producción -----------------------------------------
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---- 2. Runtime ------------------------------------------------------------
FROM base AS runner
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY worker ./worker
COPY src/lib/crm ./src/lib/crm
COPY src/types ./src/types

USER node
CMD ["npx", "tsx", "worker/index.ts"]
