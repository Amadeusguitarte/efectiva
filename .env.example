# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Medición (opcionales; si están vacíos no se carga nada)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# CRM (opcional hasta activar WhatsApp, correo o IA)
# Clave de 32 bytes en hex (openssl rand -hex 32) para cifrar claves de API y contrasenas. La usan la web y el worker.
CRM_CLAVE_CIFRADO=
# Solo el worker (nunca la web): Supabase -> Project Settings -> API Keys -> secret key
SUPABASE_SECRET_KEY=
